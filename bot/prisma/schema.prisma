generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cast {
  castHash   String   @id
  authorFid  Int
  receivedAt DateTime @default(now())
  debate     Debate?
}

model Debate {
  id              Int            @id @default(autoincrement())
  castHash        String         @unique
  cast            Cast           @relation(fields: [castHash], references: [castHash])
  chainEscrowId   BigInt?        @unique
  challengerFid   Int
  opponentFid     Int
  challengerAddr  String?
  opponentAddr    String?
  claim           String
  marketDeadline  BigInt
  joinDeadline    BigInt
  // draft | open | live | expired | cancelled | resolved
  status    DebateStatus @default(draft)
  marketId        BigInt?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  notifications   Notification[]
}

model Notification {
  debateId  Int
  kind      String
  castHash  String?
  sentAt    DateTime @default(now())
  debate    Debate   @relation(fields: [debateId], references: [id])

  @@id([debateId, kind])
}

model ChainState {
  key   String @id
  value String
}
enum DebateStatus {
  draft
  open
  live
  expired
  cancelled
  resolved
}
