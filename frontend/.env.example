# Copy to .env.local and fill in. Never commit real values.

# Privy app id (free at https://dashboard.privy.io). Required for sign-in and wallets.
# In the dashboard, enable the login methods used in src/lib/privy.ts
# (Farcaster, email, Google, wallet) and add this site's URL to the allowed domains
# (plus https://farcaster.xyz for the Farcaster mini-app).
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: WalletConnect project id (https://cloud.reown.com). Privy uses its own if empty.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: a dedicated Base Sepolia RPC URL. Leave empty to use the public endpoint.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
